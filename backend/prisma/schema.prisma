// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// Models for Learning Assistant & Second Brain
// -------------------------------------------------------------

model Subject {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  parentId    String? // Hierarchy support
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent      Subject?   @relation("SubjectToSubject", fields: [parentId], references: [id], onDelete: SetNull)
  subSubjects Subject[]  @relation("SubjectToSubject")
  documents   Document[]

  @@index([parentId])
}

model Tag {
  id            String         @id @default(uuid())
  name          String         @unique
  documents     Document[]
  studySessions StudySession[]
  terms         Term[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Document {
  id             String  @id @default(uuid())
  subjectId      String?
  studySessionId String?
  title          String
  content        String? // Optional since it might just be a local PDF

  // Metadata for Papers/Books
  author        String?
  publishedYear Int?
  tags          Tag[]

  localPath String? // Path to local file (e.g. PDF, EPUB)
  sourceUrl String?
  fileType  String? // FileType: PDF, EPUB, URL, TEXT

  status          String  @default("UNREAD") // DocumentStatus: UNREAD, READING, COMPLETED
  readingProgress String? // Page number, percentage, or bookmark marker

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject      Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  studySession StudySession? @relation(fields: [studySessionId], references: [id], onDelete: SetNull)
  terms        Term[]
  highlights   Highlight[]
  chatSessions ChatSession[]

  @@index([subjectId])
  @@index([studySessionId])
}

model Highlight {
  id         String @id @default(uuid())
  documentId String

  text         String // Original text highlighted
  aiParaphrase String? // AI paraphrased version
  aiSummary    String? // AI summary of the snippet
  pageNumber   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model StudySession {
  id        String    @id @default(uuid())
  title     String    @default("Untitled Session")
  category  String    @default("GENERAL") // StudyCategory: GENERAL, MEETING, LECTURE, RESEARCH, ENGLISH, CODING
  status    String    @default("ACTIVE") // StudyStatus: ACTIVE, PAUSED, COMPLETED, ARCHIVED
  aiSummary String?
  tags      Tag[]
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  screenshots      Screenshot[]
  audioRecords     AudioRecord[]
  conceptRelations ConceptRelation[]
  terms            Term[]
  chatSessions     ChatSession[]
  documents        Document[]
}

model Term {
  id            String  @id @default(uuid())
  termType      String  @default("VOCAB") // TermType: VOCAB, CONCEPT
  sourceType    String  @default("MANUAL") // SourceType: MANUAL, READING, SCREENSHOT, AUDIO
  documentId    String?
  screenshotId  String?
  audioRecordId String?
  sessionId     String?

  term            String
  contextSentence String?
  aiExplanation   String? // JSON stringified data (TermAiExplanation)

  ankiSyncStatus     String @default("PENDING") // AnkiSyncStatus: PENDING, SYNCED, FAILED
  obsidianSyncStatus String @default("PENDING") // ObsidianSyncStatus: PENDING, SYNCED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  document     Document?        @relation(fields: [documentId], references: [id], onDelete: SetNull)
  screenshot   Screenshot?      @relation(fields: [screenshotId], references: [id], onDelete: SetNull)
  audioRecord  AudioRecord?     @relation(fields: [audioRecordId], references: [id], onDelete: SetNull)
  studySession StudySession?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  tags         Tag[]
  flashcard    Flashcard?
  outgoing     ConceptRelation[] @relation("SourceConcept")
  incoming     ConceptRelation[] @relation("TargetConcept")

  @@index([documentId])
  @@index([screenshotId])
  @@index([audioRecordId])
  @@index([sessionId])
}

model ConceptRelation {
  id           String @id @default(uuid())
  sessionId    String
  sourceTermId String
  targetTermId String
  relationType String @default("RELATED_TO") // RelationType: RELATED_TO, CONTAINS, LEADS_TO, DEPENDS_ON, USES

  session    StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sourceTerm Term         @relation("SourceConcept", fields: [sourceTermId], references: [id], onDelete: Cascade)
  targetTerm Term         @relation("TargetConcept", fields: [targetTermId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sourceTermId, targetTermId, relationType])
  @@index([sessionId])
  @@index([sourceTermId])
  @@index([targetTermId])
}

model ChatSession {
  id            String  @id @default(uuid())
  title         String  @default("New Chat")
  sourceType    String  @default("GENERAL") // ChatSourceType: GENERAL, READING, SCREENSHOT, AUDIO
  documentId    String?
  screenshotId  String?
  audioRecordId String?
  sessionId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  document     Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  screenshot   Screenshot?   @relation(fields: [screenshotId], references: [id], onDelete: SetNull)
  audioRecord  AudioRecord?  @relation(fields: [audioRecordId], references: [id], onDelete: SetNull)
  studySession StudySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  messages AiChatHistory[]

  @@index([documentId])
  @@index([screenshotId])
  @@index([audioRecordId])
  @@index([sessionId])
}

model AiChatHistory {
  id            String @id @default(uuid())
  chatSessionId String
  role          String // ChatRole: USER, ASSISTANT
  message       String

  extractedData String? // JSON stringified data (ExtractedChatData)

  createdAt DateTime @default(now())

  chatSession ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@index([chatSessionId])
}

// -------------------------------------------------------------
// Models for Productivity & Task Management
// -------------------------------------------------------------

model Notification {
  id        String   @id @default(uuid())
  todoId    String?
  title     String
  body      String
  isRead    Boolean  @default(false)
  type      String   @default("SYSTEM") // NotificationType: SYSTEM, REMINDER, UPDATE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  todo Todo? @relation(fields: [todoId], references: [id], onDelete: Cascade)

  @@index([todoId])
}

model Schedule {
  id          String   @id @default(uuid())
  title       String
  description String?
  icon        String?
  coverImage  String?
  widgets     String?  // JSON stringified array of custom widgets
  startTime   DateTime
  endTime     DateTime
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  todos Todo[]
}

model Todo {
  id          String   @id @default(uuid())
  title       String
  description String?
  isCompleted Boolean  @default(false)
  scheduleId  String? // Optional: Null if free todo, UUID if attached to event
  parentId    String? // Optional: Link to a parent System Task
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schedule Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  parent   Todo?     @relation("TodoToTodo", fields: [parentId], references: [id], onDelete: Cascade)
  subTodos Todo[]    @relation("TodoToTodo")

  notifications Notification[]

  @@index([scheduleId])
  @@index([parentId])
}

// -------------------------------------------------------------
// Models for Media Input
// -------------------------------------------------------------

model Screenshot {
  id            String   @id @default(uuid())
  filename      String   @unique
  originalName  String?
  extractedText String?
  windowTitle   String? // Active window title when captured
  capturedAt    DateTime @default(now())
  sessionId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studySession StudySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  terms        Term[]
  chatSessions ChatSession[]

  @@index([sessionId])
}

model AudioRecord {
  id            String   @id @default(uuid())
  filename      String   @unique
  originalName  String?
  extractedText String?
  duration      Float? // System audio duration (seconds)
  capturedAt    DateTime @default(now())
  sessionId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studySession StudySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  terms        Term[]
  chatSessions ChatSession[]

  @@index([sessionId])
}

// -------------------------------------------------------------
// Models for Spaced Repetition (Anki)
// -------------------------------------------------------------

model Deck {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  flashcards Flashcard[]
}

model Flashcard {
  id     String @id @default(uuid())
  deckId String
  termId String @unique // Each Term has 1 Flashcard

  // Card content
  front String
  back  String

  // SRS Algorithm data (SM-2)
  interval       Int      @default(0)
  repetition     Int      @default(0)
  easeFactor     Float    @default(2.5)
  nextReviewDate DateTime @default(now())

  // AnkiConnect sync data
  externalNoteId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  term Term @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@index([deckId])
}

// -------------------------------------------------------------
// Models for Settings & Integrations
// -------------------------------------------------------------

model IntegrationSetting {
  id String @id @default("default")

  // Anki Settings
  defaultDeckName  String  @default("LingoAnki Default")
  defaultModelName String  @default("Basic")
  ankiConnectUrl   String  @default("http://127.0.0.1:8765")
  autoSyncAnki     Boolean @default(false)

  // Obsidian / Local Settings
  obsidianVaultPath String?
  autoSyncObsidian  Boolean @default(false)

  // System Listener Settings
  screenshotHotkey   String  @default("windows+shift+s")
  audioHotkey        String  @default("ctrl+shift+a")
  textHotkey         String  @default("ctrl+q")
  vadEnabled         Boolean @default(true)
  vadThreshold       Float   @default(0.5)
  vadSilenceDuration Float   @default(1.2)
  vadUseGpu          Boolean @default(true)

  // Marquee Banner Settings
  marqueeText      String  @default("🔥 QUYẾT TÂM!!!!! • Có tiền ít thì từ thiện ít, nhiều thì từ thiện nhiều nha!!! • Học cái hiểu biết nhiều để biết ơn • Lấy tham thiền làm niềm vui • English learner! (chuẩn bị về các cơ chế management và cách thu âm) • Bản vẽ • PHẢI OBSERVATION NHIỀU HƠN NỮA!!!!! • PHẢI BIẾT LƯỢNG SỨC MÌNH!!!")
  marqueeEnabled   Boolean @default(true)
  marqueeSpeed     Float   @default(1.0)
  marqueeDirection String  @default("left")

  // Gemini API Settings
  geminiApiKey     String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}
